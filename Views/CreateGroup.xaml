<Window x:Class="LynxUI_Main.Views.CreateGroup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LynxUI_Main.ViewModels"
        xmlns:converters="clr-namespace:LynxUI_Main.Converters"
        xmlns:controls="clr-namespace:LynxUI_Main.Custom_Controls"
        Title="Tạo nhóm mới" Width="400" Height="600"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <converters:SafeImagePathConverter x:Key="SafeImagePathConverter"/>
    </Window.Resources>

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 🔍 Search -->
        <Border Background="#F1F3F6" CornerRadius="6" Padding="6" Margin="10" BorderBrush="#DDD" BorderThickness="1">
            <DockPanel>
                <Image Source="/Assets/icon_search.png" Width="18" Height="18" Margin="0,0,6,0"/>
                <TextBox BorderThickness="0"
                         Background="Transparent"
                         VerticalContentAlignment="Center"
                         Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="14"
                         Foreground="#2C3E50" />
            </DockPanel>
        </Border>

        <!-- 📜 ListBox chọn thành viên -->
        <ListBox x:Name="UserListBox"
                 Grid.Row="1"
                 Margin="10,0,10,10"
                 ItemsSource="{Binding MatchingUsers}"
                 SelectionMode="Extended"
                 BorderThickness="0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <controls:RoundProfileButton Grid.Column="0"
                                                     Width="40" Height="40"
                                                     ProfileImageSource="{Binding AvatarImage, Converter={StaticResource SafeImagePathConverter}}"
                                                     IsOnline="{Binding IsOnline}"/>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="15"/>
                            <TextBlock>
                                <Run Text="ID: #" /><Run Text="{Binding Id}" />
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- ✅ Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
            <Button Content="Tạo nhóm" Width="100" Margin="0,0,10,0" Click="CreateGroup_Click"/>
            <Button Content="Hủy" Width="60" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
