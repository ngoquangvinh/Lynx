<Window x:Class="LynxUI_Main.ViewFrofile.EditFrofile"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cập nhật thông tin"
        Height="500" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="White">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Cập nhật thông tin cá nhân" 
                       FontSize="20" FontWeight="Bold" 
                       Foreground="#333" Margin="0,0,0,20"/>

            <!-- Họ tên -->
            <TextBlock Text="Họ tên" Margin="0,5"/>
            <TextBox x:Name="FullNameBox" Height="30" Padding="5"/>

            <!-- Email -->
            <TextBlock Text="Email" Margin="0,10,0,5"/>
            <TextBox x:Name="EmailBox" Height="30" Padding="5"/>

            <!-- Ngày sinh -->
            <TextBlock Text="Ngày sinh" Margin="0,10,0,5"/>
            <DatePicker x:Name="BirthdayPicker" Height="30" />

            <!-- Số điện thoại -->
            <TextBlock Text="Số điện thoại" Margin="0,10,0,5"/>
            <TextBox x:Name="PhoneBox" Height="30" Padding="5"/>

            <!-- Nút lưu -->
            <Button Content="Lưu thay đổi" 
                    Height="40" Margin="0,20,0,0"
                    Background="#7a6ff0" Foreground="White" 
                    FontWeight="Bold" Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
