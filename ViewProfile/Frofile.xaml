<Window x:Class="LynxUI_Main.ViewProfile.Profile"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        
        Title="Profile" Height="650" Width="400">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="41*" />
            <RowDefinition Height="0*" />
            <RowDefinition Height="215*" />
            <RowDefinition Height="61*" />
        </Grid.RowDefinitions>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Width="350" Grid.RowSpan="4" Height="572">
            <!-- Header -->
            <StackPanel Width="350" Height="200" Background="#7a6ff0">
                <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Ellipse x:Name="Myellipse" Width="120" Height="120" Margin="0,60,0,-60">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="/Assets/avatar_default.png" Stretch="UniformToFill" />
                        </Ellipse.Fill>
                    </Ellipse>
                    <Button Width="40" Height="40"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,-67"
                            Background="#eee"
                            BorderBrush="#ccc"
                            BorderThickness="1"
                            Cursor="Hand"
                            Click="CameraButton_Click"
                            ToolTip="Thay đổi ảnh đại diện">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <Ellipse Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="{TemplateBinding BorderThickness}" />
                                    <Image Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Image.Source>
                                            <BitmapImage UriSource="/ViewProfile/img/camera.png" />
                                        </Image.Source>
                                    </Image>
                                </Grid>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </StackPanel>

            <!-- Tên người dùng -->
            <TextBlock x:Name="DisplayNameTextBlock" FontSize="26" FontWeight="Bold" Foreground="#222"
                       TextAlignment="Center" Margin="0,10,0,0" />
            <TextBlock x:Name="UsernameTextBlock" FontSize="14" Foreground="Gray"
                       TextAlignment="Center" Margin="0,0,0,20" />
            <TextBlock x:Name="UserIdTextBlock"
           FontSize="14"
           Foreground="DarkGray"
           TextAlignment="Center"
           Margin="0,0,0,10" />
            <!-- Thông tin cá nhân -->
            <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="6">
                <StackPanel>
                    <StackPanel Margin="15">
                        <TextBlock Text="Email" FontWeight="SemiBold" Foreground="Gray" />
                        <TextBlock x:Name="EmailTextBlock" />
                    </StackPanel>
                    <Separator />

                    <Grid Margin="15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="SĐT" FontWeight="SemiBold" Foreground="Gray" />
                            <TextBlock x:Name="PhoneTextBlock" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Ngày sinh" FontWeight="SemiBold" Foreground="Gray" />
                            <TextBlock x:Name="BirthdayTextBlock" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Nút cập nhật -->
            <Button Content="🖊️  Cập nhật"
                    Margin="0,30,0,0"
                    Height="45"
                    Background="#7a6ff0"
                    Foreground="White"
                    FontSize="16"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="Button_Click" />
        </StackPanel>
    </Grid>
</Window>
